<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.zingg</groupId>
  <artifactId>zingg-native-parent</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <!-- Production artifact. The legacy Connect planner experiment is opt-in only. -->
  <modules><module>core</module></modules>

  <properties>
    <scala.version>2.13.16</scala.version>
    <spark.version>4.0.0</spark.version>
    <!-- Serverless environment 5 exposes Databricks Connect 18 to Python,
         while its Scala/JVM Maven coordinate is 18.0.0. Keep the two
         contracts distinct instead of using the Python patch version as a
         Maven artifact version. -->
    <databricks.connect.version>18.0.0</databricks.connect.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement><dependencies>
    <dependency><groupId>org.scala-lang</groupId><artifactId>scala-library</artifactId><version>${scala.version}</version></dependency>
    <dependency><groupId>org.apache.spark</groupId><artifactId>spark-sql_2.13</artifactId><version>${spark.version}</version></dependency>
    <dependency><groupId>org.apache.spark</groupId><artifactId>spark-mllib_2.13</artifactId><version>${spark.version}</version></dependency>
    <dependency><groupId>com.databricks</groupId><artifactId>databricks-connect_2.13</artifactId><version>${databricks.connect.version}</version></dependency>
  </dependencies></dependencyManagement>

  <profiles>
    <profile>
      <id>spark40</id>
      <properties><spark.version>4.0.0</spark.version></properties>
    </profile>
    <profile>
      <id>spark41</id>
      <properties><spark.version>4.1.0</spark.version></properties>
    </profile>
    <profile>
      <id>databricks-dedicated-17.3</id>
      <properties><spark.version>4.0.0</spark.version><scala.version>2.13.16</scala.version></properties>
    </profile>
    <profile>
      <id>databricks-dedicated-18-lts</id>
      <properties><spark.version>4.1.0</spark.version><scala.version>2.13.16</scala.version></properties>
    </profile>
    <profile>
      <id>legacy-model-converter</id>
      <modules><module>legacy-model-converter</module></modules>
    </profile>
    <profile>
      <id>databricks-serverless-env5</id>
      <modules><module>serverless-launcher</module></modules>
      <properties>
        <scala.version>2.13.16</scala.version>
        <databricks.connect.version>18.0.0</databricks.connect.version>
        <maven.compiler.release>17</maven.compiler.release>
      </properties>
    </profile>
  </profiles>
</project>
